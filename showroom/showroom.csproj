<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <FFmpegAutoGenVersion Condition="'$(FFmpegAutoGenVersion)' == '' and '$(RuntimeIdentifier)' == 'linux-x64'">7.1.1</FFmpegAutoGenVersion>
    <FFmpegAutoGenVersion Condition="'$(FFmpegAutoGenVersion)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">7.1.1</FFmpegAutoGenVersion>
    <FFmpegAutoGenVersion Condition="'$(FFmpegAutoGenVersion)' == ''">9.0.1.1</FFmpegAutoGenVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="FFmpeg.AutoGen" Version="$(FFmpegAutoGenVersion)" Aliases="FFmpegAutoGen" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SimpleM3U8Parser" Version="1.0.0" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>showroom.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
